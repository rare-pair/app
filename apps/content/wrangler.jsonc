{
  // Content Worker: epub images and original downloads, served as they are from R2, and robots.txt.
  // It answers only on content.rarepair.fans (ARCHITECTURE, Why these pieces, Hosts).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rarepair-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // pg needs Node's net and crypto.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "content.rarepair.fans", "custom_domain": true }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rarepair" }],
  // Neon Postgres, to read a work's status before a miss is served (ARCHITECTURE, Author
  // requests & takedowns). It is the config
  // with caching off, the one apps/web's HYPERDRIVE uses (ARCHITECTURE, Connections): a hide must
  // be seen by the next miss, not after a cached read expires. Tests replace the local connection
  // string with their own database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4513add0a933451b8b1657e6caec3537",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
  // GET and HEAD of an original, per client (an IPv4 address or an IPv6 /64), counted after the
  // refusals and before the cache (spec 24). Images aren't limited. A first value, to be revisited
  // in load testing. A namespace_id is account-wide: apps/web/wrangler.jsonc lists the blocks.
  "ratelimits": [
    { "name": "ORIGINAL_LIMIT", "namespace_id": "1052", "simple": { "limit": 10, "period": 60 } },
  ],
  // Invocation logs and traces are off, so no line is kept for every request and no span records a
  // URL (#124, #572). Errors, metrics and each refusal's reason line stay, and a reason line
  // stores the path of its request, which carries the AO3 work id, with no address or user agent,
  // for 7 days (measured on the web Worker 2026-11-07; assumed the same here). redact_query_string
  // is on to keep query strings out; it is documented to remove them from request URLs in logs
  // and traces. Whether it clears a custom line is unconfirmed until the live check. To trace a live fault, set
  // traces.enabled to true and deploy, then set it back to false (ARCHITECTURE, Why these pieces, Hosts).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
