{
  "name": "@archive/content",
  "version": "0.0.0",
  "private": true,
  "description": "Content Worker: serves epub images and original downloads from R2 on content.rarepair.fans.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@archive/db": "*",
    "kysely": "^0.29.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "4.156.0"
  }
}
