{
  // Sweep Worker: once a day it deletes, under each `works/<ao3_work_id>/` folder in R2, the
  // images no version references and the `<upload_id>/` prefixes no version or in-flight job
  // owns, older than 24 hours (ARCHITECTURE, EPUB processor). Under a removed work's folder it
  // deletes everything, of any age, plus `originals/<upload_id>.epub` for each upload prefix
  // there, unless a job of the work is running (ARCHITECTURE, Removal really removes). It
  // reads Postgres through Hyperdrive. It also removes uploads left unconfirmed past
  // UNCONFIRMED_UPLOAD_DAYS, rows and `uploads/` objects (ARCHITECTURE, Orphaned uploads). No
  // routes: nothing reaches it but the cron.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rarepair-sweep",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // pg needs Node's net and crypto.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Daily, at 03:17 UTC: off-peak, and off the hour. A run spends a bounded number of
  // subrequests (src/sweep.ts), so it needs Workers Paid.
  "triggers": { "crons": ["17 3 * * *"] },
  // A Worker gets 30 seconds of CPU unless this says more; a run reads and scans many fragments.
  // Five minutes, under the 15-minute wall time a cron invocation has.
  "limits": { "cpu_ms": 300000 },
  // The upload page's refusal past the cap tells people this age: apps/web/src/quota.ts.
  "vars": { "UNCONFIRMED_UPLOAD_DAYS": "1" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rarepair" }],
  // Neon Postgres. It is the
  // config with caching off, the one apps/web's HYPERDRIVE uses (ARCHITECTURE, Connections): the
  // sweep decides what to delete from what it reads, so every read must be fresh (src/sweep.ts
  // also keeps its reads uncacheable). Tests replace the local connection string with their
  // own database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4513add0a933451b8b1657e6caec3537",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
  "observability": { "enabled": true },
}
