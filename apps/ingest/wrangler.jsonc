{
  // Ingest Worker: consumes the ingest queue, one `{upload_id}` per message (ARCHITECTURE,
  // Ingestion pipeline and EPUB processor). It reads the upload from R2 and writes Postgres
  // through Hyperdrive. No routes: nothing reaches it but the queue.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rarepair-ingest",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // pg needs Node's net and crypto.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "queue": "ingest",
        // One upload an invocation (ARCHITECTURE, Ingestion pipeline), so a crash in one job has no
        // batch-mate to spend the retries of. It holds one epub and its parse in memory.
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        // At most two invocations at once: a flood waits in the backlog instead of opening
        // more Postgres connections and Worker memory than that.
        "max_concurrency": 2,
        // Three retries, two minutes apart, for R2 and Postgres outages. The job's lease is
        // 60 seconds, under the retry delay, so a retry of a crashed job finds its lease
        // expired. src/config.ts mirrors max_retries and the lease.
        "max_retries": 3,
        "retry_delay": 120,
        // A job that fails for good is recorded as parse_failed, then dead-lettered here.
        "dead_letter_queue": "ingest-dlq",
      },
      {
        // Fails an upload whose job never recorded an ending (ARCHITECTURE, EPUB processor,
        // step 8). One message an invocation, so a hung query can't cost another its retries, and
        // one invocation at once, so it holds one Postgres connection. An hour of retries, to
        // outlast a short outage, each after a job's lease has run out. An outage longer than
        // that deletes the message, and the upload stays as it was: there is no redrive, and no
        // dead-letter queue behind this one.
        "queue": "ingest-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 30,
        "retry_delay": 120,
      },
      {
        // The re-sanitize backfill (ARCHITECTURE, EPUB processor, step 8): one `{work_id,
        // version_id}` a message, put there by scripts/backfill.mjs. One work a batch and one
        // invocation at once, so a run over every stored work holds one Postgres connection
        // and one epub, and leaves the rest to the uploads on the ingest queue.
        "queue": "ingest-backfill",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        // Retries for R2 and Postgres outages only: a file the current processor refuses is
        // logged and acked, leaving the work's current version as it is.
        "max_retries": 3,
        "retry_delay": 120,
        "dead_letter_queue": "ingest-backfill-dlq",
      },
    ],
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rarepair" }],
  // Neon Postgres. It is the
  // config with caching off, the one apps/web's HYPERDRIVE uses: reads here feed writes, so none
  // may be old (ARCHITECTURE, Connections). Tests replace the local connection string with
  // their own database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4513add0a933451b8b1657e6caec3537",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
  "observability": { "enabled": true },
}
