{
  // The web Worker is routed on rarepair.fans and www.rarepair.fans only, and www
  // just redirects to the bare domain (ARCHITECTURE, Hosts).
  "name": "rarepair-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Better Auth needs AsyncLocalStorage, and pg needs Node's net and crypto (ARCHITECTURE, Auth).
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "rarepair.fans/*", "zone_name": "rarepair.fans" },
    { "pattern": "www.rarepair.fans/*", "zone_name": "rarepair.fans" },
  ],
  // No second copy of the app on a workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  // The wait list pages' fonts and stylesheet, under /assets/waitlist/. The Worker runs first
  // on every request and serves them through a route, so they get HSTS, the www 308
  // and the content-hashed files their Cache-Control, from the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // Neon Postgres, through two Hyperdrive configs (ARCHITECTURE, Connections). Tests replace the
  // local connection string with their own database.
  // HYPERDRIVE is the one with caching off: sessions, roles, moderation, uploads, and every read
  // a public page doesn't make. HYPERDRIVE_CACHED has caching on and serves public pages only
  // (src/home.ts, listing.ts, search.ts, work-page.ts, reader.ts, full.ts, warnings.ts).
  // The two ids must differ: one id pasted into both puts every read in the cache, and nothing
  // in the repo can see it. Check caching on each with `wrangler hyperdrive list`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4513add0a933451b8b1657e6caec3537",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres",
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "2ed351f55aa644fd9483e3c79ee66401",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
  // Chapter fragments, which the reader reads under works/ only. The same bucket
  // apps/content serves images and originals from.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rarepair" }],
  // Reading positions: one `pos:<user id>:<work id>` key per signed-in reader and work, holding a
  // chapter number and a scroll percentage, expiring after a year (src/position.ts). Tests use a
  // local one.
  "kv_namespaces": [{ "binding": "POSITIONS", "id": "ef28ee98accc48da818bed1a468846e6" }],
  // Sign-in emails, sent by apps/mailer. This Worker also consumes email-bulk-dlq, where a launch
  // email both providers refused lands: src/launch-dead-letter.ts clears its address's
  // notified_at so the launch send queues it again (ARCHITECTURE, Wait list). Retention is
  // one day at most, set outside this file:
  // wrangler queues update email-bulk-dlq --message-retention-period-secs 86400
  "queues": {
    // `ingest` is the upload queue apps/ingest consumes: POST /uploads/:id/complete sends to it.
    "producers": [
      { "binding": "EMAIL", "queue": "email" },
      { "binding": "INGEST", "queue": "ingest" },
    ],
    "consumers": [
      {
        "queue": "email-bulk-dlq",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        // A database outage retries the batch for ten minutes before it is dropped.
        "max_retries": 10,
        "retry_delay": 60,
      },
    ],
  },
  // The Workers rate-limiting binding on POST /login (ARCHITECTURE, Surge controls): per client
  // IP and per email address, each over a 60-second window. src/rate-limit.ts keeps the period
  // too, for Retry-After. A namespace_id is account-wide, and bindings sharing one share
  // counters, so each limit takes its own from a reserved block: 1001-1009 sign-in,
  // 1010-1019 uploads, 1020-1029 search, 1030-1039 removal requests, 1040-1049 the wait list.
  "ratelimits": [
    { "name": "LOGIN_IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_EMAIL_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    // POST /waitlist, the same way. Set like sign-in's, to be revisited before launch: a shared
    // office or school IP on launch day may want a higher IP limit.
    {
      "name": "WAITLIST_IP_LIMIT",
      "namespace_id": "1040",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "WAITLIST_EMAIL_LIMIT",
      "namespace_id": "1041",
      "simple": { "limit": 3, "period": 60 },
    },
    // POST /dmca, per client IP, counted before the body is read and before its Turnstile
    // check (the form has no address to key on). A first value, to be revisited with the others.
    // 1035, from the removal-requests block, clear of the ids /remove will take from 1030.
    { "name": "DMCA_IP_LIMIT", "namespace_id": "1035", "simple": { "limit": 5, "period": 60 } },
    // POST /remove, per client IP and per contact email. The IP is counted before the form is
    // read; the email only once Turnstile passes and the address is valid, so an unsolved post
    // can't spend someone else's address. Instant hiding has no proof of identity behind it,
    // so these are its defence against abuse. First values (IP 5, email 3), to be revisited
    // before launch: a shared office or school IP may want a higher IP limit.
    { "name": "REMOVE_IP_LIMIT", "namespace_id": "1030", "simple": { "limit": 5, "period": 60 } },
    {
      "name": "REMOVE_EMAIL_LIMIT",
      "namespace_id": "1031",
      "simple": { "limit": 3, "period": 60 },
    },
    // POST /uploads, per signed-in user and per client IP. The first unit of each is counted
    // before the form is read, so a flood costs neither a body nor a Turnstile check, and a
    // refused request counts. A batch spends one unit per file, the rest once its sizes are
    // checked and before Turnstile, so a batch of ten takes ten of the user's 20 and of the
    // IP's 40. First values (user 20, IP 40), to be revisited before launch: a shared office
    // or school IP may want a higher IP limit. The Postgres count is the daily quota (ARCHITECTURE, Surge
    // controls); this binding is only approximate and per location.
    {
      "name": "UPLOAD_USER_LIMIT",
      "namespace_id": "1010",
      "simple": { "limit": 20, "period": 60 },
    },
    { "name": "UPLOAD_IP_LIMIT", "namespace_id": "1011", "simple": { "limit": 40, "period": 60 } },
    // GET /search, per signed-in user and per client IP. Counted once the query is known to be
    // non-blank and before the search queries the database, so a refused search runs no query
    // of its own (a request with a cookie has had its session looked up by then);
    // each results page spends one, the bare form none. A signed-out search is keyed on its IP
    // only. Values: user 60, IP 30 a minute, as the operator set them for launch. A shared
    // office or school IP may hit the IP limit first. Approximate and per location, like the
    // others.
    {
      "name": "SEARCH_IP_LIMIT",
      "namespace_id": "1020",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SEARCH_USER_LIMIT",
      "namespace_id": "1021",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Invocation logs are off: a reading URL carries the AO3 work id and chapter number. Errors and
  // metrics stay on, and the console.error lines the code logs on purpose are expected to be kept
  // (not yet verified on the platform; ARCHITECTURE, Observability). Traces are not set here: whether they go on is the operator's call (#620).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "vars": {
    // "on" until the archive opens (ARCHITECTURE, Wait list): / is the coming-soon
    // page and other app pages redirect to it. Only "off" turns it off; a missing or
    // misspelt value keeps it on.
    "PRELAUNCH": "on",
    // The public Turnstile sitekey of every Turnstile form: coming-soon, sign-in, upload, removal and copyright notice. The widget is for
    // rarepair.fans, with its secret in TURNSTILE_SECRET_KEY. Without a matching pair those forms fail closed (the copyright notice form too: the page's email address is the only way to send one).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF0X4q4IwNS4pX4A",
    // The bucket presigned upload URLs PUT into, under uploads/ (src/presign.ts). It must be
    // the BUCKET binding's bucket_name above, which /complete and ingest read uploads from.
    "R2_BUCKET": "rarepair",
    // The least time POST /waitlist takes to answer, in milliseconds, so how long it took
    // can't show whether an address is on the list (#216). It must be longer than the
    // slowest path (insert, update, queue send, over Hyperdrive to Neon): a floor can't hide
    // a path slower than itself. 2000 is a first value, to be checked against measured
    // Hyperdrive timing before launch.
    "WAITLIST_FLOOR_MS": "2000",
    // Where the removal form's <noscript> message sends a visitor without JavaScript. A
    // placeholder on the reserved example.invalid domain. The operator deploys with the
    // moderators' real address in its place (`wrangler deploy --var MODERATORS_EMAIL:...`);
    // the repo's code, notes and tests never hold one.
    "MODERATORS_EMAIL": "moderators@example.invalid",
    // The address the copyright notice page names: in its <noscript> message for a visitor without JavaScript, and on a refusal that stops the form working (rate limit, failed or unreachable Turnstile check).
    // The mailbox must exist and be read: mail there doesn't reach the takedowns queue.
    "NOTICES_EMAIL": "admin@rarepair.fans",
    // The most uploads an account may confirm in a UTC day (src/quota.ts): the new-account
    // tier, which every account but a moderator or admin gets, and the trusted tier of
    // moderators and admins. ARCHITECTURE (Surge controls) sets them before launch from load
    // testing; these are first values, to be revisited then.
    "UPLOAD_QUOTA_NEW": "20",
    "UPLOAD_QUOTA_TRUSTED": "100",
    // The most sign-in emails one address may be sent in a UTC day (src/quota.ts), counted in
    // Postgres because the rate-limiting bindings only have short windows. ARCHITECTURE (Surge
    // controls) records the limit this leaves.
    "LOGIN_EMAIL_QUOTA": "5",
    // The rarepair.fans zone, whose cache a work's removal purges (src/purge.ts): its pages and
    // fragments, and content.rarepair.fans's image and download URLs (a custom domain on the
    // same zone), in case the zone caches them. Not a secret. A placeholder: the operator deploys with the real id in its place
    // (`wrangler deploy --var CLOUDFLARE_ZONE_ID:...`). Under the placeholder every purge
    // fails, and the remove says so.
    "CLOUDFLARE_ZONE_ID": "00000000000000000000000000000000",
  },
  // Set with `wrangler secret put`. IP_HASH_KEY also keys the daily sign-in count's stored address
  // hash (src/ip-hash.ts). It keys the HMAC of a requester's stored network
  // address (src/ip-hash.ts): a long random value, kept for as long as stored hashes are
  // matched, since changing it orphans them. The R2 ones sign upload URLs: an R2 API token with Object
  // Read and Write on the rarepair bucket only. Only its secret key is secret: every issued URL
  // shows the access key id and the account id, which are here only to keep them out of the repo.
  // CLOUDFLARE_PURGE_TOKEN is the Cloudflare API token a removal purges the cache with: permission
  // Zone > Cache Purge > Purge, on the rarepair.fans zone only.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "TURNSTILE_SECRET_KEY",
      "IP_HASH_KEY",
      "R2_ACCOUNT_ID",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "CLOUDFLARE_PURGE_TOKEN",
    ],
  },
}
