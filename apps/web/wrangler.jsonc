{
  // The web Worker is routed on rarepair.fans and www.rarepair.fans only, and www
  // just redirects to the bare domain (ARCHITECTURE, Hosts).
  "name": "rarepair-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Better Auth needs AsyncLocalStorage, and pg needs Node's net and crypto (ARCHITECTURE, Auth).
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "rarepair.fans/*", "zone_name": "rarepair.fans" },
    { "pattern": "www.rarepair.fans/*", "zone_name": "rarepair.fans" },
  ],
  // No second copy of the app on a workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  // The wait list pages' fonts and stylesheet, under /assets/waitlist/. The Worker runs first
  // on every request and serves them through a route, so they get HSTS, the www 308
  // and the content-hashed files their Cache-Control, from the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // Neon Postgres. The id is a placeholder until the Hyperdrive config is created; tests replace
  // the local connection string with their own database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
  // Chapter fragments, which the reader reads under works/ only. The same bucket
  // apps/content serves images and originals from.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rarepair" }],
  // Sign-in emails, sent by apps/mailer. This Worker also consumes email-bulk-dlq, where a launch
  // email both providers refused lands: src/launch-dead-letter.ts clears its address's
  // notified_at so the launch send queues it again (ARCHITECTURE, Wait list). Retention is
  // one day at most, set outside this file:
  // wrangler queues update email-bulk-dlq --message-retention-period-secs 86400
  "queues": {
    "producers": [{ "binding": "EMAIL", "queue": "email" }],
    "consumers": [
      {
        "queue": "email-bulk-dlq",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        // A database outage retries the batch for ten minutes before it is dropped.
        "max_retries": 10,
        "retry_delay": 60,
      },
    ],
  },
  // The Workers rate-limiting binding on POST /login (ARCHITECTURE, Surge controls): per client
  // IP and per email address, each over a 60-second window. src/rate-limit.ts keeps the period
  // too, for Retry-After. A namespace_id is account-wide, and bindings sharing one share
  // counters, so each limit takes its own from a reserved block: 1001-1009 sign-in,
  // 1010-1019 uploads, 1020-1029 search, 1030-1039 removal requests, 1040-1049 the wait list.
  "ratelimits": [
    { "name": "LOGIN_IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_EMAIL_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    // POST /waitlist, the same way. Set like sign-in's, to be revisited before launch: a shared
    // office or school IP on launch day may want a higher IP limit.
    {
      "name": "WAITLIST_IP_LIMIT",
      "namespace_id": "1040",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "WAITLIST_EMAIL_LIMIT",
      "namespace_id": "1041",
      "simple": { "limit": 3, "period": 60 },
    },
    // POST /dmca, per client IP only: the form has no Turnstile (it must work without
    // JavaScript) and no address to key on. A first value, to be revisited with the others.
    // 1035, from the removal-requests block, clear of the ids /remove will take from 1030.
    { "name": "DMCA_IP_LIMIT", "namespace_id": "1035", "simple": { "limit": 5, "period": 60 } },
  ],
  "vars": {
    // "on" until the archive opens (ARCHITECTURE, Wait list): / is the coming-soon
    // page and other app pages redirect to it. Only "off" turns it off; a missing or
    // misspelt value keeps it on.
    "PRELAUNCH": "on",
    // The public Turnstile sitekey of the coming-soon and sign-in forms. This is Cloudflare's
    // always-passes test sitekey: replace it with the real one before launch. Cloudflare
    // refuses its tokens under a real secret key, so until then those forms fail closed.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // The bucket presigned upload URLs PUT into, under uploads/ (src/presign.ts). It must be
    // the BUCKET binding's bucket_name above, which /complete and ingest read uploads from.
    "R2_BUCKET": "rarepair",
    // The least time POST /waitlist takes to answer, in milliseconds, so how long it took
    // can't show whether an address is on the list (#216). It must be longer than the
    // slowest path (insert, update, queue send, over Hyperdrive to Neon): a floor can't hide
    // a path slower than itself. 2000 is a first value, to be checked against measured
    // Hyperdrive timing before launch.
    "WAITLIST_FLOOR_MS": "2000",
  },
  // Set with `wrangler secret put`. The R2 ones sign upload URLs: an R2 API token with Object
  // Read and Write on the rarepair bucket only. Only its secret key is secret: every issued URL
  // shows the access key id and the account id, which are here only to keep them out of the repo.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "TURNSTILE_SECRET_KEY",
      "R2_ACCOUNT_ID",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
    ],
  },
}
