{
  "name": "@archive/web",
  "version": "0.0.0",
  "private": true,
  "description": "The web Worker for rarepair.fans: server-rendered pages behind a strict CSP.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@types/node": "^24.0.0",
    "miniflare": "5.20261023.3-beta",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@archive/db": "*",
    "@better-auth/kysely-adapter": "1.7.14",
    "better-auth": "1.7.14",
    "hono": "4.13.14",
    "kysely": "^0.29.7"
  }
}
