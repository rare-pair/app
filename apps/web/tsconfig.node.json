{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "test/global-setup.ts",
    "test/provided.d.ts",
    "test/stand-ins.ts",
    "browser/**/*.ts"
  ]
}
