{
  "name": "solid-octo-guacamole",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:browser": "npm run test:browser -w @archive/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "overrides": {
    "@oxlint/plugins": "$@oxlint/plugins"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/pg": "^8.15.0",
    "ai-deslop": "0.4.9",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "^8.23.1"
  }
}
